tier = input().strip()
p = float(input())
t = float(input())

d = p

if tier == "Gold":
    d = p * 0.80
    if d > 400.0:
        d -= 50.0
    elif int(p) % 2 == 0:
        d -= 10.0

elif tier == "Silver":
    if p > 300.0:
        d = p * 0.85
    elif 100.0 <= p <= 300.0:
        d = p * 0.90
    else:
        d = p - 0.5
        if d < 0.0:
            d = 0.0

elif tier == "Bronze":
    if p > 150.0:
        if int(p) % 2 == 0:
            d = p * 0.93
        else:
            d = p * 0.95
    else:
        d = p

else:

    d = p

total = d + d * (t / 100.0)

print(f"{total:.2f}")